# Supabase — waitlist ledger. The service-role key is server-only and bypasses
# RLS, so it must never be exposed to the browser or committed.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend — welcome email + operator notification. RESEND_FROM must use a domain
# you have verified in Resend.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM="Kloyya <updates@yourdomain.com>"
